# ══ Express ══
PORT=3000
NODE_ENV=development

# ══ PGlite (dejar vacío para in-memory en tests) ══
PGLITE_WRITE_DIR=./data/write
PGLITE_READ_DIR=./data/read

# ══ JWT ══
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ══ Snapshots ══
SNAPSHOT_INTERVAL=50

# ══ Projections ══
PROJECTION_POLL_MS=1000

# ══ CORS ══
CORS_ORIGINS=http://localhost:5173

# ══ Rate Limiting ══
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ══ Idempotency ══
IDEMPOTENCY_TTL_MS=86400000

# ══ RabbitMQ (opcional — sin URL, OutboxRelay queda desactivado) ══
# AMQP_URL=amqps://user:pass@host/vhost
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=100
