# ══ Express ══
PORT=3000
NODE_ENV=development

# ══ PostgreSQL (Neon) ══
DATABASE_WRITE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/bank_write?sslmode=require
DATABASE_READ_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/bank_read?sslmode=require

# ══ JWT ══
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ══ Snapshots ══
SNAPSHOT_INTERVAL=50

# ══ Projections ══
PROJECTION_POLL_MS=1000

# ══ CORS ══
CORS_ORIGINS=http://localhost:5173

# ══ Rate Limiting ══
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ══ Idempotency ══
IDEMPOTENCY_TTL_MS=86400000

# ══ RabbitMQ (opcional — sin URL, OutboxRelay queda desactivado) ══
# AMQP_URL=amqps://user:pass@host/vhost
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=100
