{
  "name": "banking-app",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "packages/core/*",
    "packages/contexts/*",
    "packages/server/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "db:generate": "drizzle-kit generate --config=packages/core/event-store/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=packages/core/event-store/drizzle.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@hookform/resolvers": "^3.6.0",
    "@tanstack/react-query": "^5.45.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.1.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "lucide-react": "^0.395.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "reflect-metadata": "^0.2.2",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.3.0",
    "tsyringe": "^4.8.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "msw": "^2.3.1",
    "postcss": "^8.4.38",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.7.0",
    "turbo": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.1",
    "vitest": "^2.1.0"
  }
}
