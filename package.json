{
  "name": "banking-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "workspaces": [
    "packages/core/*",
    "packages/contexts/*",
    "packages/server/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "generate-keys": "node --import tsx scripts/generate-keys.ts",
    "db:generate:write": "drizzle-kit generate --config=packages/core/event-store/drizzle.config.ts",
    "db:generate:read": "drizzle-kit generate --config=packages/core/projection-engine/drizzle.config.ts",
    "db:generate": "pnpm run db:generate:write && pnpm run db:generate:read"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.45.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.1.5",
    "drizzle-orm": "^0.45.0",
    "express": "^5.0.0",
    "lucide-react": "^0.577.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.51.5",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^3.0.0",
    "tsyringe": "^4.8.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@swc-node/register": "^1.10.0",
    "@swc/core": "^1.7.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.0.0",
    "msw": "^2.3.1",
    "postcss": "^8.4.38",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.7.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  }
}
